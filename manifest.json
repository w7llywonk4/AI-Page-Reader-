{
  "manifest_version": 3,
  "name": "study study sahurrr",
  "version": "3.0",
  "description": "Page intelligence with AI interaction — study anything, click anything",
  "permissions": ["activeTab", "scripting", "sidePanel", "tabs"],
  "host_permissions": ["<all_urls>"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "study study sahurrr",
    "default_icon": { "48": "icon.png" }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["inject.css"],
      "run_at": "document_idle"
    }
  ]
}
